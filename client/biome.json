{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "*.ts",
      "*.json",
      "!src/net/bindings",
      "!dist",
      "!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/render/**",
        "!src/render/bootstrap.ts",
        "!src/render/floor-stacks.ts",
        "!src/render/pixi-order.ts",
        "!src/render/pixi-visibility.ts",
        "!src/render/appearance/composite-canvas.ts",
        "!src/render/appearance/part-sheets.ts",
        "!src/render/appearance/appearance-texture.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [{ "group": ["pixi.js", "../test-street/*", "../test-street/**"] }]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/input/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "pixi.js",
                      "../net/*",
                      "../net/**",
                      "../test-street/*",
                      "../test-street/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/world/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "world/** is the pure movement/collision layer -- DOM access belongs in src/input/ or src/test-street/",
                  "document": "world/** is the pure movement/collision layer -- DOM access belongs in src/input/ or src/test-street/"
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "pixi.js",
                      "../net/*",
                      "!../net/bindings/types",
                      "../test-street/*",
                      "../test-street/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
