{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "*.ts",
      "*.json",
      "!src/net/bindings",
      "!tests/e2e/boot-budget/bindings",
      "!dist",
      "!dist-boot-budget-decode",
      "!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "src/render/**",
        "!src/render/floor-stacks.ts",
        "!src/render/pixi-order.ts",
        "!src/render/pixi-visibility.ts",
        "!src/render/pixi-highlight.ts",
        "!src/render/atlas-pages.ts",
        "!src/render/appearance/composite-pages.ts",
        "!src/render/appearance/appearance-texture.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "pixi.js",
                      "../test-street/*",
                      "../test-street/**",
                      "../ui/*",
                      "../ui/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/input/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "pixi.js",
                      "../net/*",
                      "../net/**",
                      "../test-street/*",
                      "../test-street/**",
                      "../ui/*",
                      "../ui/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/time/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "time/** is the pure in-city clock layer -- DOM access belongs in main.ts",
                  "document": "time/** is the pure in-city clock layer -- DOM access belongs in main.ts"
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["pixi.js", "../net/*", "../net/**"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/world/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "world/** is the pure movement/collision layer -- DOM access belongs in src/input/ or src/test-street/",
                  "document": "world/** is the pure movement/collision layer -- DOM access belongs in src/input/ or src/test-street/"
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "pixi.js",
                      "../net/*",
                      "!../net/bindings/types",
                      "../test-street/*",
                      "../test-street/**",
                      "../ui/*",
                      "../ui/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "pixi.js",
                      "../net/*",
                      "../net/**",
                      "!../net/connection-status",
                      "../render/**",
                      "../world/**",
                      "../test-street/*",
                      "../test-street/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/render/**",
        "src/world/**",
        "src/input/**",
        "src/ui/**",
        "src/net/**",
        "src/defs/**",
        "src/boot/**",
        "src/settings/**",
        "src/test-street/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../debug/*", "../debug/**"]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/debug/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "pixi.js",
                      "../net/*",
                      "../net/**",
                      "!../net/bindings/types",
                      "../test-street/*",
                      "../test-street/**",
                      "../ui/*",
                      "../ui/**"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/render/**", "src/net/**", "src/defs/**", "src/boot/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "document": "DOM creation belongs in src/ui/, src/input/, src/test-street/ or main.ts -- window stays allowed (e2e-hooks.ts, pixel-snapshot.ts use it)"
                }
              }
            }
          }
        }
      }
    }
  ]
}
