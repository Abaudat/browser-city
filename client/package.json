{
  "name": "browsercity-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format .",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:perf": "playwright test --project=perf",
    "test:e2e:boot": "playwright test --project=boot",
    "test:e2e:deploy-smoke": "playwright test --project=deploy-smoke"
  },
  "dependencies": {
    "pixi.js": "8.20.1",
    "spacetimedb": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@types/pngjs": "6.0.5",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "fast-check": "4.10.0",
    "jsdom": "30.0.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
