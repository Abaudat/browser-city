*.sh text eol=lf
*.cmd text eol=crlf

# defs/ content and its own test fixtures: tools/defs-build/tests/
# failure_fixtures.rs asserts an exact line:column against these files, and
# defs_version is a hash over defs/ itself -- both must read identical
# bytes on a Windows checkout and a Linux CI runner (docs/architecture.md's
# "defs/" section).
defs/**/*.toml text eol=lf
tools/defs-build/**/*.toml text eol=lf
tools/defs-build/**/*.rs text eol=lf
tools/defs-build/goldens/defs-manifest.golden linguist-generated text eol=lf

# The cross-parser golden and shared malformed-payload table both server
# and client tests are byte-compared against (Quentin's direction).
fixtures/defs-dump.v1.golden text eol=lf
fixtures/defs-malformed-cases.v1.json text eol=lf
fixtures/defs-malformed-payloads/**/*.json text eol=lf

# Generated SpacetimeDB TypeScript bindings -- never hand-edited, guarded
# instead by scripts/ci/check-bindings-current.sh.
client/src/net/bindings/** linguist-generated

# Generated by tools/defs-build -- never hand-edited, guarded instead by
# scripts/ci/check-defs-current.sh. LF forced: tools/defs-build writes LF
# only (docs/architecture.md), and a Windows checkout's CRLF normalisation
# would otherwise make the committed file byte-differ from every fresh
# regeneration.
server/sim/src/generated/defs.rs linguist-generated text eol=lf
client/public/defs/defs.json linguist-generated text eol=lf

# Story 2.6: packed atlas pages -- never hand-edited, guarded by the same
# check-defs-current.sh (extended to diff this whole directory). Binary,
# so no eol normalisation ever applies to it.
client/public/atlas/** binary linguist-generated

# Client sources: `npm run lint` is `biome check`, which formats to LF
# (Biome's own default) and is the exact check CI runs. On a CRLF working
# copy every file reports a format error, the 20-diagnostic cap truncates
# the real findings away behind them, and the check becomes unusable
# locally -- which is how a formatting error reaches CI at all. Forcing LF
# here makes the local run and the CI run the same run.
client/**/*.ts text eol=lf
client/**/*.mjs text eol=lf
client/**/*.json text eol=lf
client/**/*.html text eol=lf
